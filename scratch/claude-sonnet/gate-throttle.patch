index 0000000..6fde2b5
--- /dev/null
+++ b/src/gats-community/src/gate-core.js
@@ -0,0 +1,84 @@
+// Failure-only brute-force throttle (fixes #9). Pure logic + injected storage, so it can be unit-tested in node.
+//  - counts FAILED logins only (successes never consume the window; shared NATs stay usable)
+//  - three scopes: ip (IPv6 normalised to /64), (ip,login) pair, login across all IPs
+//  - the pair lock trips first, so a stranger cannot cheaply lock a victim out; the account-wide lock needs many failures
+//  - counters live in memory; from PERSIST_FROM failures on they are also written to DO storage, so an attacker
+//    cannot reset them just by waiting for the object to be evicted. Writes are bounded (<= LIMIT per key per window).
+
+export const GATE = {
+  WINDOW_MS: 15 * 60_000,
+  LOCK_MS: 10 * 60_000,
+  LIMITS: { ip: 30, pair: 6, login: 40 },
+  PERSIST_FROM: 3,
+};
+
+export function ipKey(ip) {
+  const s = String(ip || 'unknown').toLowerCase();
+  if (!s.includes(':') || s.includes('.')) return s; // IPv4, IPv4-mapped, or 'unknown'
+  const [head, tail] = s.split('::');
+  const h = head ? head.split(':') : [];
+  const t = tail ? tail.split(':') : [];
+  const groups = s.includes('::') ? [...h, ...Array(Math.max(8 - h.length - t.length, 0)).fill('0'), ...t] : h;
+  return groups.slice(0, 4).map((g) => g.padStart(4, '0')).join(':') + '::/64';
+}
+
+export class GateCore {
+  // store: { list(): Promise<[key, value][]>, put(k, v), delete(k) }
+  constructor(store) { this.store = store; this.mem = new Map(); }
+
+  async load(now = Date.now()) {
+    for (const [k, v] of await this.store.list()) {
+      if (v && v.reset > now) this.mem.set(k, v);
+      else await this.store.delete(k);
+    }
+  }
+
+  keys(ip, login) {
+    return { ip: 'g:ip:' + ip, pair: 'g:pr:' + ip + '|' + login, login: 'g:lg:' + login };
+  }
+
+  entry(k, now) {
+    const e = this.mem.get(k);
+    if (!e || e.reset <= now) { this.mem.delete(k); return null; }
+    return e;
+  }
+
+  lockedFor(k, limit, now) {
+    const e = this.entry(k, now);
+    return e && e.n >= limit ? Math.ceil((e.reset - now) / 1000) : 0;
+  }
+
+  check(ip, login, now = Date.now()) {
+    const k = this.keys(ip, login), L = GATE.LIMITS;
+    const retryAfter = Math.max(this.lockedFor(k.ip, L.ip, now), this.lockedFor(k.pair, L.pair, now), this.lockedFor(k.login, L.login, now));
+    const pe = this.entry(k.pair, now);
+    return { locked: retryAfter > 0, retryAfter, pairFails: pe ? pe.n : 0 };
+  }
+
+  async fail(ip, login, now = Date.now()) {
+    const k = this.keys(ip, login), L = GATE.LIMITS;
+    for (const [key, limit] of [[k.ip, L.ip], [k.pair, L.pair], [k.login, L.login]]) await this.bump(key, limit, now);
+    if (this.mem.size > 5000) await this.sweep(now);
+  }
+
+  async bump(key, limit, now) {
+    let e = this.entry(key, now) || { n: 0, reset: now + GATE.WINDOW_MS };
+    if (e.n >= limit) return;                        // already locked: no more writes
+    e.n++;
+    if (e.n >= limit) e.reset = now + GATE.LOCK_MS;  // lock for LOCK_MS from the tripping failure
+    this.mem.set(key, e);
+    // Small limits (pair) persist every failure from PERSIST_FROM; broad scopes (ip, login) only every 5th and at lock time,
+    // which bounds storage writes to ~20 per attacker per window instead of one per guess.
+    if (e.n >= GATE.PERSIST_FROM && (limit <= 10 || e.n % 5 === 0 || e.n >= limit)) await this.store.put(key, e);
+  }
+
+  async ok(ip, login) {
+    const key = this.keys(ip, login).pair;
+    if (this.mem.delete(key)) await this.store.delete(key);
+  }
+
+  async sweep(now = Date.now()) {
+    for (const [k, e] of this.mem) if (e.reset <= now) { this.mem.delete(k); await this.store.delete(k); }
+    if (this.mem.size > 5000) this.mem.clear();      // last resort; locks persisted in storage reload on next wake
+  }
+}
