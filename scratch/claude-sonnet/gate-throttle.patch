diff --git a/src/gats-community/test/gate-core.test.mjs b/src/gats-community/test/gate-core.test.mjs
new file mode 100644
index 0000000..9954d05
--- /dev/null
+++ b/src/gats-community/test/gate-core.test.mjs
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import { GateCore, GATE, ipKey } from '../src/gate-core.js';
+
+const mkStore = () => { const m = new Map(); return { m, list: async () => [...m.entries()], put: async (k, v) => m.set(k, structuredClone(v)), delete: async (k) => m.delete(k) }; };
+const T0 = 1_000_000;
+let n = 0; const ok = (name) => console.log('ok', ++n, name);
+
+// IPv6 /64 normalisation
+assert.equal(ipKey('2001:db8:1:2:aaaa:bbbb:cccc:dddd'), '2001:0db8:0001:0002::/64'); ok('ipv6 full -> /64');
+assert.equal(ipKey('2001:db8:1:2::9'), ipKey('2001:db8:1:2:ffff::1')); ok('same /64 collapses');
+assert.equal(ipKey('2001:db8::1'), '2001:0db8:0000:0000::/64'); ok(':: expansion');
+assert.equal(ipKey('203.0.113.9'), '203.0.113.9'); assert.equal(ipKey(null), 'unknown'); ok('ipv4 / unknown');
+
+// pair lock after 6 failures, not before; success never counts
+{
+  const g = new GateCore(mkStore());
+  for (let i = 0; i < 5; i++) await g.fail('1.1.1.1', 'bob', T0 + i);
+  assert.equal(g.check('1.1.1.1', 'bob', T0 + 10).locked, false); ok('5 fails: not locked');
+  await g.fail('1.1.1.1', 'bob', T0 + 11);
+  const c = g.check('1.1.1.1', 'bob', T0 + 12);
+  assert.equal(c.locked, true); assert.ok(c.retryAfter > 500 && c.retryAfter <= 600); ok('6th fail locks pair ~10 min');
+  assert.equal(g.check('9.9.9.9', 'bob', T0 + 12).locked, false); ok('victim NOT locked out for other IPs (griefing limited)');
+  assert.equal(g.check('1.1.1.1', 'alice', T0 + 12).locked, false); ok('same IP, other account unaffected');
+  assert.equal(g.check('1.1.1.1', 'bob', T0 + GATE.LOCK_MS + 20).locked, false); ok('lock expires');
+}
+// eviction: persisted counters survive a new instance
+{
+  const store = mkStore();
+  const a = new GateCore(store);
+  for (let i = 0; i < 6; i++) await a.fail('2.2.2.2', 'carol', T0 + i);
+  const b = new GateCore(store); await b.load(T0 + 100);   // simulates DO eviction + wake
+  assert.equal(b.check('2.2.2.2', 'carol', T0 + 100).locked, true); ok('lock survives eviction');
+  const s2 = mkStore(); const c1 = new GateCore(s2);
+  for (let i = 0; i < 4; i++) await c1.fail('3.3.3.3', 'dave', T0 + i);
+  const c2 = new GateCore(s2); await c2.load(T0 + 50);
+  await c2.fail('3.3.3.3', 'dave', T0 + 60); await c2.fail('3.3.3.3', 'dave', T0 + 61);
+  assert.equal(c2.check('3.3.3.3', 'dave', T0 + 62).locked, true); ok('pacing across evictions cannot reset counter (>=3 persisted)');
+}
+// ip-wide spraying across many accounts
+{
+  const g = new GateCore(mkStore());
+  for (let i = 0; i < 30; i++) await g.fail('4.4.4.4', 'user' + i, T0 + i);
+  assert.equal(g.check('4.4.4.4', 'fresh', T0 + 40).locked, true); ok('IP spraying across accounts locks the IP');
+}
+// success clears the pair counter; writes are bounded
+{
+  const st = mkStore(); const g = new GateCore(st);
+  for (let i = 0; i < 4; i++) await g.fail('5.5.5.5', 'erin', T0 + i);
+  await g.ok('5.5.5.5', 'erin');
+  assert.equal(g.check('5.5.5.5', 'erin', T0 + 10).pairFails, 0); ok('success clears pair counter');
+  let puts = 0; const st2 = mkStore(); const orig = st2.put; st2.put = async (...a) => { puts++; return orig(...a); };
+  const h = new GateCore(st2); let verified = 0;
+  for (let i = 0; i < 100; i++) {                       // real flow: a locked pair never reaches the password check
+    if (h.check('6.6.6.6', 'frank', T0 + i).locked) continue;
+    verified++; await h.fail('6.6.6.6', 'frank', T0 + i);
+  }
+  assert.equal(verified, 6); ok('attacker gets only 6 password checks per pair, not 100');
+  assert.ok(puts <= 8, 'puts=' + puts); ok('storage writes bounded (puts=' + puts + ')');
+  // worst case for broad scopes: one IP rotating through accounts until the IP lock trips
+  let puts2 = 0; const st3 = mkStore(); const o3 = st3.put; st3.put = async (...a) => { puts2++; return o3(...a); };
+  const w = new GateCore(st3);
+  for (let i = 0; i < 100; i++) { if (w.check('8.8.8.8', 'victim' + i, T0 + i).locked) continue; await w.fail('8.8.8.8', 'victim' + i, T0 + i); }
+  assert.ok(puts2 <= 20, 'puts2=' + puts2); ok('IP rotation across accounts: writes bounded (puts=' + puts2 + ')');
+}
+// expired entries are swept
+{
+  const st = mkStore(); const g = new GateCore(st);
+  for (let i = 0; i < 4; i++) await g.fail('7.7.7.7', 'gina', T0 + i);
+  await g.sweep(T0 + GATE.WINDOW_MS + 10);
+  assert.equal(st.m.size, 0); ok('sweep removes expired persisted entries');
+}
+console.log('ALL PASSED');
