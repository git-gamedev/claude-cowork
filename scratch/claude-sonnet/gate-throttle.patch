 // Durable Objects.
 //  Room: one per gats server. Hibernating WebSockets. Per-socket state lives in the socket
 //        attachment (survives hibernation); no SQLite writes. D1 is read only as a fallback.
-//  Gate (rate limiting) now lives in gate.js.
+//  Gate: ONE global object. Failure-only login throttle (see gate-core.js).
 
 import { DurableObject } from 'cloudflare:workers';
+import { GateCore } from './gate-core.js';
 
 const TIMEOUT_MS = 90_000;   // drop sockets silent for this long
 const ALARM_MS = 60_000;     // sweep interval while anyone is connected
@@ -185,3 +186,24 @@ export class Room extends DurableObject {
     if (a && a.pid) { this.broadcast({ t: 'leave', pid: a.pid }, ws); a.pid = null; a.gname = ''; try { ws.serializeAttachment(a); } catch {} }
   }
 }
+
+export class Gate extends DurableObject {
+  // One global instance ('g'). POST /check | /fail | /ok with { ip, login }.
+  constructor(ctx, env) {
+    super(ctx, env);
+    this.core = new GateCore({
+      list: async () => [...(await ctx.storage.list({ prefix: 'g:' })).entries()],
+      put: (k, v) => ctx.storage.put(k, v),
+      delete: (k) => ctx.storage.delete(k),
+    });
+    ctx.blockConcurrencyWhile(() => this.core.load());
+  }
+  async fetch(request) {
+    const op = new URL(request.url).pathname.slice(1);
+    const { ip, login } = await request.json();
+    if (op === 'check') return Response.json(this.core.check(ip, login));
+    if (op === 'fail') { await this.core.fail(ip, login); return Response.json({ ok: true }); }
+    if (op === 'ok') { await this.core.ok(ip, login); return Response.json({ ok: true }); }
+    return new Response('not found', { status: 404 });
+  }
+}
